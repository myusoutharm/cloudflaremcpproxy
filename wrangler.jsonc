{
  "name": "cloudflaremcpproxy",
  "main": "worker.js",
  "compatibility_date": "2026-05-26",
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_STATE",
        "class_name": "OAuthState"
      }
    ]
  },
  "exports": {
    "OAuthState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}